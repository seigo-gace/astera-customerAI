CUSTOMER_AI_DATA_ROOT=/data/customer-ai
# Inbound signature used by the generic gateway destination when delivering to /internal/customer-ai/accept.
CUSTOMER_AI_HMAC_SECRET=base64:replace_with_private_runtime_outbound_secret

# Generic Webhook Gateway internal event API used for accepted/completed/recovery events.
INTERNAL_EVENT_API_URL=https://webhooks.asterav8.jp/internal/events
INTERNAL_EVENT_API_TOKEN=replace_with_long_random_internal_api_token
INTERNAL_EVENT_SOURCE_ID=hf-private-runtime
# Deployment-registered generic destination that returns events to the Cloudflare result receiver.
INTERNAL_EVENT_RESULT_DESTINATION_ID=app-receiver
INTERNAL_EVENT_API_TIMEOUT_SECONDS=10

NOTION_TOKEN=
# CustomerAI_Master_v2 data source. The old 13-column KB must not be configured here.
NOTION_DATA_SOURCE_ID=d4003654-ce9a-43cb-8cb6-20401d179580
# CustomerAI_Index_v2 is retrieval metadata only. Its fields never enter model context.
NOTION_INDEX_DATA_SOURCE_ID=014f4a72-e01f-41b0-9992-55be47a4aba4
# Apache-2.0 public-weight model executed locally in the private HF Space.
CUSTOMER_AI_MODEL_ID=Qwen/Qwen3-0.6B
CUSTOMER_AI_MODEL_REVISION=c1899de289a04d12100db370d81485cdf75e47ca
CUSTOMER_AI_ENABLE_MODEL=1
CUSTOMER_AI_GPU_DAILY_BUDGET_SECONDS=3600
CUSTOMER_AI_NODE_BINARY=node
CUSTOMER_AI_NODE_SOCKET=/tmp/customer-ai-v8.sock
CUSTOMER_AI_NODE_MEMORY_MB=384
CUSTOMER_AI_JOB_LEASE_SECONDS=90
CUSTOMER_AI_SESSION_LEASE_SECONDS=90
CUSTOMER_AI_MAX_INPUT_CHARS=20000
CUSTOMER_AI_PROCESS_CONCURRENCY=2
CUSTOMER_AI_SESSION_CACHE_TTL_SECONDS=1800
CUSTOMER_AI_SESSION_CACHE_MAX_SESSIONS=256
CUSTOMER_AI_SESSION_CACHE_MAX_TURNS=12
CUSTOMER_AI_KB_CACHE_TTL_SECONDS=120
CUSTOMER_AI_KB_CACHE_MAX_ENTRIES=512
