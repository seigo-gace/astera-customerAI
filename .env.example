# Runtime wiring only. Do not commit real secrets.
HF_TOKEN=
CUSTOMER_AI_HF_API_URL=https://router.huggingface.co/v1/chat/completions

# Canonical/Current knowledge snapshots. Runtime remains not_ready until the canonical KB snapshot exists.
CUSTOMER_AI_KB_SNAPSHOT_PATH=
CUSTOMER_AI_KB_GENERATION_ID=
CUSTOMER_AI_CURRENT_FACTS_PATH=

# Optional Japanese alias registry JSON. Empty means no alias expansion.
CUSTOMER_AI_ALIAS_REGISTRY_PATH=
CUSTOMER_AI_JA_FUZZY_THRESHOLD=90

# Public browser origins allowed to call the repository-owned Customer AI API implementation.
CUSTOMER_AI_ALLOWED_ORIGINS=https://asterav8.jp
